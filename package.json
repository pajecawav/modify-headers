{
	"name": "modify-headers",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "cross-env FORCE_COLOR=1 run-p -l watch start:chromium",
		"build": "cross-env FORCE_COLOR=1 run-s -l build:rsbuild build:webext",
		"build:rsbuild": "rsbuild build",
		"build:webext": "web-ext build --source-dir dist --overwrite-dest",
		"watch": "rsbuild build --watch",
		"start:chromium": "web-ext run -s dist -t chromium --start-url=example.com",
		"start:firefox": "web-ext run -s dist -t firefox-desktop --start-url=example.com",
		"lint": "cross-env FORCE_COLOR=1 run-p -l lint:*",
		"lint:oxlint": "oxlint .",
		"lint:tsc": "tsc -b --noEmit",
		"lint:format": "pt format",
		"format": "pt format --write",
		"test": "playwright test",
		"prepare": "pt prepare"
	},
	"dependencies": {
		"nanoid": "^6.0.2",
		"solid-js": "^1.9.18",
		"werpc": "^0.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@pajecawav/tools": "^0.1.0",
		"@playwright/test": "^1.64.1",
		"@rsbuild/core": "^2.3.0",
		"@rsbuild/plugin-babel": "^2.1.0",
		"@rsbuild/plugin-solid": "^1.2.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.6",
		"chrome-types": "^0.1.461",
		"cross-env": "^10.1.0",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.4",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"web-ext": "^10.8.0"
	},
	"packageManager": "pnpm@12.16.1"
}
