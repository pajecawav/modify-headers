{
	"$schema": "https://json.schemastore.org/chrome-manifest",
	"name": "modify-headers",
	"description": "Modify HTTP headers",
	"version": "0.0.1",
	"manifest_version": 3,
	"permissions": ["declarativeNetRequest", "storage", "offscreen"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"theme_icons": [
			{
				"light": "assets/logo16.png",
				"dark": "assets/logo-white16.png",
				"size": 16
			},
			{
				"light": "assets/logo32.png",
				"dark": "assets/logo-white32.png",
				"size": 32
			},
			{
				"light": "assets/logo48.png",
				"dark": "assets/logo-white48.png",
				"size": 48
			},
			{
				"light": "assets/logo128.png",
				"dark": "assets/logo-white128.png",
				"size": 128
			}
		]
	},
	"options_page": "options.html",
	"icons": {
		"16": "assets/logo16.png",
		"32": "assets/logo32.png",
		"48": "assets/logo48.png",
		"128": "assets/logo128.png",
		"256": "assets/logo256.png"
	}
}
